# Copy this file to .env and fill in every value before running docker compose.
# Never commit .env to source control.

# ── Server ────────────────────────────────────────────────────────────────────

# Public hostname — used by Caddy to obtain a TLS certificate and by the
# box-auth helper to construct the OAuth2 redirect URI.
# Example: music.svpb.org
DOMAIN=

# Password for the /admin dashboard. Choose something strong.
ADMIN_PASSWORD=

# ── GitHub ────────────────────────────────────────────────────────────────────

# Shared secret configured in the svpb-music GitHub webhook settings.
# Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# HTTPS clone URL of the svpb-music repository.
SVPB_MUSIC_REPO_URL=https://github.com/SVPB/svpb-music.git

# ── Box ───────────────────────────────────────────────────────────────────────

# OAuth2 credentials from the Box Developer Console.
# See README.md § Box OAuth2 for setup instructions.
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_REFRESH_TOKEN=

# Numeric ID of the Box folder to upload PDFs into.
# Found in the URL when viewing the folder: app.box.com/folder/XXXXXXXXXX
BOX_FOLDER_ID=

# ── Slack ─────────────────────────────────────────────────────────────────────

# Incoming Webhook URL from api.slack.com/apps.
# See README.md § Slack incoming webhook for setup instructions.
SLACK_WEBHOOK_URL=
