# Copy this file to .env and fill in every value before running docker compose.
# Never commit .env to source control.

# ── Server ────────────────────────────────────────────────────────────────────

# Public hostname — used by Caddy to obtain a TLS certificate and by the
# box-auth helper to construct the OAuth2 redirect URI.
# Example: musictools.siliconvalleypipeband.com
DOMAIN=

# Which published image to run. On a production server leave this unset: it
# runs "latest", the newest build of main. Pin a release version (e.g. "0.6.0")
# only to roll back. The "develop" image is for testing on your own machine,
# not for a server.
# TNG_IMAGE_TAG=0.6.0

# Directory on the host holding everything that cannot be regenerated: the
# SQLite database (data/) and Caddy's ACME account key and certificates
# (caddy/data/, caddy/config/).  On a server this should point at a mount that
# outlives the machine — on Digital Ocean, a Block Storage volume, which is
# mounted at /mnt/<volume-name> with hyphens as underscores.
# See README.md § Persistent state.
# Leave unset for local development, where it defaults to ./state in the
# checkout.
# TNG_STATE_DIR=/mnt/tng_state

# ── Slack ─────────────────────────────────────────────────────────────────────

# Bot token for the TNG Slack app (xoxb-...). Used to send login links and
# build notifications via chat.postMessage.
# From: api.slack.com/apps → your app → OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=

# Signing secret for verifying inbound Events API payloads.
# From: api.slack.com/apps → your app → Basic Information → Signing Secret
SLACK_SIGNING_SECRET=

# Incoming Webhook URL for posting build notifications to a channel.
# From: api.slack.com/apps → your app → Incoming Webhooks
SLACK_WEBHOOK_URL=

# Slack user ID of the first admin user. On first startup (empty User table)
# TNG creates an admin record for this user. Obtain the ID from the Slack
# profile page: click ⋯ → Copy member ID.
# Example: U012AB3CD
INITIAL_ADMIN_SLACK_USER_ID=

# ── GitHub ────────────────────────────────────────────────────────────────────

# Shared secret configured in the svpb-music GitHub webhook settings.
# Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# HTTPS clone URL of the svpb-music repository.
SVPB_MUSIC_REPO_URL=https://github.com/SVPB/svpb-music.git

# Path where TNG checks out per-branch copies of the repo and writes output
# PDFs.  Under docker compose this is set to /app/music by the compose file
# itself, to guarantee it matches the music-workspace volume mount; a value set
# here is ignored in that case.  Only relevant when running outside compose.
# Defaults to ./music if unset.
# MUSIC_WORKSPACE_PATH=/app/music

# ── Box ───────────────────────────────────────────────────────────────────────

# OAuth2 credentials from the Box Developer Console.
# See README.md § Box OAuth2 for setup instructions.
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=

# Optional. TNG obtains and stores its own refresh token when you authorize it from
# /admin/connections, and rotates it on every build. Set this only to seed a server from
# a token obtained some other way (the `box-auth` command); leaving it empty is normal,
# and the server starts without it so that it can be authorized from the browser.
BOX_REFRESH_TOKEN=

# Optional. How often TNG renews its Box refresh token, in hours. Defaults to 24.
# Box expires a refresh token 60 days after its last use, and a build is the only thing
# that would otherwise use one — so the server renews on a timer instead, and a season
# with no music edits cannot kill its access. Lower it only for testing.
BOX_TOKEN_REFRESH_HOURS=

# Numeric ID of the top-level pipe_music folder in Box.
# TNG uploads PDFs into year-named subfolders of this folder (e.g. pipe_music/2026/).
# Subfolders are created automatically if they do not exist; you do NOT need to
# pre-create them.  The folder for each year is named after the git branch (e.g. "2026").
#
# To find the ID: navigate to the pipe_music folder on box.com.
# The ID is the number at the end of the URL:
#   https://app.box.com/folder/XXXXXXXXXX
BOX_FOLDER_ID=

# ── Backups ───────────────────────────────────────────────────────────────────

# Optional. Where TNG copies its database every night. Leave these unset to
# run without backups; set some but not enough and TNG reports what is missing
# on the admin Connections page and in Slack.
# See README.md § Backups.
#
# The endpoint is the bucket's Origin Endpoint, from its settings page, which
# names both the bucket and the region.
# BACKUP_ENDPOINT=https://tng-backups.sfo3.digitaloceanspaces.com
#
# A Spaces access key has three parts, and only two of them go here:
#   - its name, the label you chose (e.g. "tng-backups") — not used;
#   - its Access Key ID (DO00…), shown beside the name on the bucket's
#     settings page whenever you look — BACKUP_ACCESS_KEY;
#   - its Secret Key, shown only once, when the key is created —
#     BACKUP_SECRET_KEY. If it was not saved then, it cannot be recovered;
#     create a new key.
# BACKUP_ACCESS_KEY=
# BACKUP_SECRET_KEY=

# Optional. Only for an endpoint that does not name the bucket — a regional
# Spaces endpoint or another S3-compatible store. Must agree with the endpoint
# if both name one.
# BACKUP_BUCKET=

# Optional. Prepended to each backup's object name. Defaults to tng/.
# BACKUP_PREFIX=tng/

# Optional. The signing region. Read from a digitaloceanspaces.com endpoint,
# us-east-1 otherwise.
# BACKUP_REGION=

# Optional. Hours between backups. Defaults to 24.
# BACKUP_INTERVAL_HOURS=
