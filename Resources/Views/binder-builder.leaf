#extend("layouts/public"):

#export("title"):Personal Binder Builder — SVPB TNG#endexport

#export("styles"):
#extend("partials/tune-selector-styles")
<style>
  .btn-share   { background: #e0e7ff; color: #3730a3; border: 1px solid #a5b4fc; }
  .btn-share:hover { background: #c7d2fe; }
  #status-msg { font-size: 0.85rem; margin-top: 0.75rem; min-height: 1.2em; }
  #status-msg.error { color: #c00; }
  #status-msg.info  { color: #166534; }
  #download-section { display: none; margin-top: 1rem; padding: 1rem; background: #f0fdf4; border-radius: 6px; border: 1px solid #bbf7d0; }
  #download-section a { font-weight: 600; color: #166534; }
  .progress { font-size: 0.85rem; color: #666; }
  .share-url { font-family: monospace; font-size: 0.8rem; word-break: break-all; background: #f5f5f5; padding: 0.4rem; border-radius: 4px; margin-top: 0.5rem; }
</style>
#endexport

#export("content"):
<main>

  <!-- Left column: tune catalogue -->
  <div>
    #extend("partials/tune-catalogue"):
      #export("binder-name-label"):Your binder name#endexport
      #export("binder-name-placeholder"):e.g. My 2026 Binder#endexport
    #endextend
  </div>

  <!-- Right column: selected entries + download -->
  <div>
    <div class="card">
      #extend("partials/binder-entries"):
        #export("entries-heading"):Your Binder#endexport
      #endextend

      <div style="display:flex;gap:0.5rem;margin-top:1rem;flex-wrap:wrap;">
        <button class="btn btn-primary" onclick="requestPDF()">Generate PDF</button>
        <button class="btn btn-share" onclick="shareURL()">Share URL</button>
        <button class="btn" onclick="TuneSelector.clear()">Clear</button>
      </div>

      <div id="status-msg"></div>

      <div id="download-section">
        <strong>Your binder is ready!</strong><br>
        <a id="download-link" href="#">Download PDF</a>
      </div>

      <div id="share-section" style="display:none;margin-top:1rem;">
        <label>Shareable URL:</label>
        <div class="share-url" id="share-url-text"></div>
        <button class="btn" style="margin-top:0.4rem;font-size:0.8rem;padding:0.25rem 0.75rem;"
                onclick="copyShareURL()">Copy</button>
      </div>
    </div>
  </div>

</main>
#endexport

#export("scripts"):
<script src="/js/tune-selector.js"></script>
<script>
'use strict';

let pollTimer = null;

// ── Initialise, restoring from a shared URL if one was given ───────────────
const INITIAL_SPEC = '#if(encodedSpec):#(encodedSpec)#endif';

TuneSelector.init({
  sections: true,
  setStatus,
  onClear: () => {
    document.getElementById('download-section').style.display = 'none';
    document.getElementById('share-section').style.display = 'none';
    if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
  },
  restore: async (branches, sel) => {
    if (!INITIAL_SPEC) return false;
    try {
      const spec = decodeSpec(INITIAL_SPEC);
      if (spec.branch && branches.some(b => b.name === spec.branch)) {
        sel.value = spec.branch;
        document.getElementById('binder-name').value = spec.name || '';
        await TuneSelector.loadTunes(spec.branch);
        // URLs shared before sections existed carry a flat `entries` list.
        const saved = Array.isArray(spec.sections)
          ? spec.sections
          : [{ title: '', entries: spec.entries || [] }];
        TuneSelector.setPacks(spec.pack);
        // `title` is a string or, since #46, a list of lines; `load` takes either.
        await TuneSelector.load(saved.map(s => ({
          title: s.title || '',
          toc: !!s.toc,
          entries: (s.entries || []).map(e => ({
            tuneSlug: e.tune_slug, parts: e.parts, pageBreak: e.break === 'before',
          })),
        })));
      }
    } catch (_) { /* ignore malformed spec */ }
    return true;
  },
});

// ── Output ─────────────────────────────────────────────────────────────────
async function requestPDF() {
  const branch = TuneSelector.branch();
  const name = TuneSelector.binderName('My Binder');
  if (!branch) { setStatus('Please select a year first.', 'error'); return; }
  if (TuneSelector.entries().length === 0) { setStatus('Please add at least one tune.', 'error'); return; }

  document.getElementById('download-section').style.display = 'none';
  setStatus('Submitting binder request…', 'info');

  const spec = buildSpec(branch, name);

  try {
    const res = await fetch('/binders', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(spec),
    });
    if (!res.ok) {
      const txt = await res.text();
      setStatus('Error: ' + txt, 'error');
      return;
    }
    const dto = await res.json();
    setStatus('Generating your PDF… this may take a moment.', 'info');
    pollForCompletion(dto.id);
  } catch (e) {
    setStatus('Request failed: ' + e.message, 'error');
  }
}

function pollForCompletion(binderId) {
  if (pollTimer) clearInterval(pollTimer);
  pollTimer = setInterval(async () => {
    try {
      const res = await fetch(`/binders/${binderId}`);
      const dto = await res.json();
      if (dto.status === 'ready') {
        clearInterval(pollTimer);
        pollTimer = null;
        setStatus('Your binder is ready!', 'info');
        const dl = document.getElementById('download-section');
        dl.style.display = 'block';
        document.getElementById('download-link').href = dto.downloadURL;
      }
    } catch (_) { /* keep polling */ }
  }, 2000);
}

function shareURL() {
  const branch = TuneSelector.branch();
  const name = TuneSelector.binderName('My Binder');
  if (!branch || TuneSelector.entries().length === 0) {
    setStatus('Select a year and add tunes first.', 'error');
    return;
  }
  const spec = buildSpec(branch, name);
  const encoded = encodeSpec(spec);
  const url = `${location.origin}/binder-builder?spec=${encodeURIComponent(encoded)}`;
  document.getElementById('share-url-text').textContent = url;
  document.getElementById('share-section').style.display = '';
}

function copyShareURL() {
  const text = document.getElementById('share-url-text').textContent;
  navigator.clipboard.writeText(text).then(() => setStatus('URL copied!', 'info'));
}

function buildSpec(branch, name) {
  const spec = {
    name,
    branch,
    // A section with neither a title nor any tunes prints nothing; one with a
    // title and no tunes is a title page and goes in as it stands (#46), and a
    // table of contents goes in with or without a heading (#47). One line is
    // written as a string, as every spec before #46 was, so a binder shared
    // today decodes the same way as one shared last week, and `toc` is written
    // only where there is one.
    sections: TuneSelector.sections()
      .filter(s => s.entries.length > 0 || TuneSelector.titleLines(s).length > 0
                || TuneSelector.isContents(s))
      .map(s => {
        const title = TuneSelector.titleLines(s);
        const section = {
          title: title.length > 1 ? title : (title[0] || null),
          entries: s.entries.map(e => {
            const entry = { tune_slug: e.tuneSlug, parts: e.parts };
            // Only meaningful in a packed binder, so only written in one.
            if (TuneSelector.packs() && e.pageBreak) entry.break = 'before';
            return entry;
          }),
        };
        if (TuneSelector.isContents(s)) section.toc = true;
        return section;
      }),
  };
  // Written only where it is asked for, so a binder shared today decodes the same
  // way as one shared before packing existed.
  if (TuneSelector.packs()) spec.pack = true;
  return spec;
}

// `btoa` accepts only Latin-1, and section titles are free text ("Sìne Bhàn"),
// so the spec goes through UTF-8 bytes first.
function encodeSpec(spec) {
  const bytes = new TextEncoder().encode(JSON.stringify(spec));
  let binary = '';
  bytes.forEach(b => { binary += String.fromCharCode(b); });
  return btoa(binary);
}

// URLs shared before the UTF-8 step were plain `btoa` of the JSON, so bytes
// that are not valid UTF-8 are read back as the Latin-1 they were written as.
function decodeSpec(encoded) {
  const binary = atob(encoded);
  const bytes = Uint8Array.from(binary, c => c.charCodeAt(0));
  let json;
  try {
    json = new TextDecoder('utf-8', { fatal: true }).decode(bytes);
  } catch (_) {
    json = binary;
  }
  return JSON.parse(json);
}

function setStatus(msg, cls) {
  const el = document.getElementById('status-msg');
  el.textContent = msg;
  el.className = cls ? cls : '';
}
</script>
#endexport

#endextend
