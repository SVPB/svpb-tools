#extend("layouts/public"):

#export("title"):Connections — SVPB TNG#endexport

#export("styles"):
<style>
  main  { max-width: 900px; margin: 2rem auto; padding: 0 1rem; }
  .lede { color: #555; font-size: 0.92rem; margin-bottom: 1.5rem; max-width: 62ch; }
  .card { background: #fff; border-radius: 8px; padding: 1.25rem; box-shadow: 0 1px 3px rgba(0,0,0,.1); margin-bottom: 1rem; }
  .card-head { display: flex; align-items: baseline; gap: 0.75rem; flex-wrap: wrap; }
  .card-head h2 { font-size: 1.05rem; margin: 0; }
  .purpose { color: #555; font-size: 0.88rem; margin: 0.35rem 0 0.9rem; }
  .state { display: inline-block; padding: 2px 10px; border-radius: 10px; font-size: 0.78rem; font-weight: 600; }
  .state-working      { background: #dcfce7; color: #166534; }
  .state-failing      { background: #fee2e2; color: #991b1b; }
  .state-unconfigured { background: #e5e7eb; color: #374151; }
  .detail { font-size: 0.9rem; margin: 0 0 0.35rem; }
  .credential { font-size: 0.85rem; color: #555; margin: 0 0 0.35rem; }
  .error { font-size: 0.85rem; color: #991b1b; margin: 0.5rem 0 0; font-family: ui-monospace, monospace; word-break: break-word; }
  .actions { margin-top: 0.9rem; display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap; }
  .btn { padding: 6px 16px; border-radius: 4px; border: 1px solid #1a1a2e; background: #1a1a2e; color: #fff; cursor: pointer; font-size: 0.85rem; }
  .btn:hover { background: #2a2a4e; }
  details.remedy { font-size: 0.85rem; }
  details.remedy summary { cursor: pointer; color: #1a1a2e; }
  details.remedy p { color: #555; margin: 0.5rem 0 0; max-width: 62ch; }
  .redirect { background: #fff; border-radius: 8px; padding: 1.25rem; box-shadow: 0 1px 3px rgba(0,0,0,.1); font-size: 0.88rem; color: #555; }
  .redirect code { background: #f3f4f6; padding: 2px 6px; border-radius: 3px; font-size: 0.85rem; }
  .refresh { font-size: 0.85rem; }
</style>
#endexport

#export("content"):
<main>
  <h1>Connections</h1>
  <p class="lede">
    Every service TNG talks to, and whether it answered just now. Each was asked a real
    question — not just checked for a credential — so a green row means the link works,
    not that something is configured.
  </p>

  #for(connection in connections):
  <div class="card" id="connection-#(connection.id)">
    <div class="card-head">
      <h2>#(connection.name)</h2>
      <span class="state state-#(connection.state)">#(connection.state)</span>
    </div>
    <p class="purpose">#(connection.purpose)</p>

    #if(connection.detail):<p class="detail">#(connection.detail)</p>#endif
    #if(connection.credential):<p class="credential">#(connection.credential)</p>#endif
    #if(connection.error):<p class="error">#(connection.error)</p>#endif

    <div class="actions">
      #if(connection.authorizePath):
      <button class="btn" onclick="authorize('#(connection.authorizePath)')">
        #if(connection.state == "working"):Re-authorise#else:Authorise#endif #(connection.name)
      </button>
      #endif
      #if(connection.remedy):
      <details class="remedy">
        <summary>How to fix this</summary>
        <p>#(connection.remedy)</p>
      </details>
      #endif
    </div>
  </div>
  #endfor

  <p class="redirect">
    <strong>Box redirect URI.</strong> Box only sends a browser back to an address
    registered for the application, so this exact value has to be listed under
    <em>OAuth 2.0 Redirect URIs</em> in the Box Developer Console:<br>
    <code>#(redirectURI)</code>
  </p>

  <p class="refresh"><a href="/admin/connections">Check again</a></p>
</main>
#endexport

#export("scripts"):
<script>
// The consent screen opens in a popup so the page behind it keeps its place; the popup
// reloads this window when it is done. A blocked popup falls back to this tab, which
// works just as well — it simply loses the reload.
function authorize(path) {
  const popup = window.open(path, 'tng-authorize', 'width=620,height=760');
  if (!popup) { window.location.href = path; }
}
</script>
#endexport

#endextend
