<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Build #(buildId) — SVPB TNG</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body   { font-family: system-ui, sans-serif; margin: 0; background: #f5f5f5; color: #222; }
    header { background: #1a1a2e; color: #fff; padding: 1rem 2rem; display: flex; justify-content: space-between; align-items: center; }
    header h1 { margin: 0; font-size: 1.2rem; }
    nav a  { color: rgba(255,255,255,.8); text-decoration: none; font-size: 0.9rem; margin-right: 1.25rem; }
    nav a:hover { color: #fff; }
    main   { max-width: 1000px; margin: 2rem auto; padding: 0 1rem; }
    .meta-grid { display: grid; grid-template-columns: max-content 1fr; gap: 0.4rem 1rem; background: #fff; border-radius: 8px; padding: 1.25rem; margin-bottom: 1.5rem; box-shadow: 0 1px 3px rgba(0,0,0,.1); }
    .meta-grid dt { font-weight: 600; color: #555; }
    .status-running { color: #b45309; font-weight: 600; }
    .status-success { color: #166534; font-weight: 600; }
    .status-failure { color: #991b1b; font-weight: 600; }
    h2 { font-size: 1rem; margin: 1.5rem 0 0.5rem; }
    pre { background: #1a1a2e; color: #d4d4d4; padding: 1rem; border-radius: 8px; overflow-x: auto; font-size: 0.82rem; line-height: 1.5; white-space: pre-wrap; word-break: break-word; }
    ul  { background: #fff; border-radius: 8px; padding: 1rem 1rem 1rem 2rem; box-shadow: 0 1px 3px rgba(0,0,0,.1); }
    a   { color: #1a1a2e; }
    .back { display: inline-block; margin-bottom: 1rem; font-size: 0.9rem; }
  </style>
</head>
<body>

<header>
  <h1>🎵 SVPB TNG — Build Detail</h1>
  <nav>
    <a href="/admin">Dashboard</a>
    <a href="/admin/users">Users</a>
  </nav>
</header>

<main>

  <a class="back" href="/admin">← Back to dashboard</a>

  <dl class="meta-grid">
    <dt>Build ID</dt>  <dd><code>#(buildId)</code></dd>
    <dt>Branch</dt>    <dd><strong>#(branch)</strong></dd>
    <dt>Triggered</dt> <dd>#(triggeredISO)</dd>
    <dt>Status</dt>    <dd class="status-#(status)">#(status)</dd>
    <dt>Commit</dt>    <dd><code>#(commitSha)</code></dd>
  </dl>

  #if(!files.isEmpty):
  <h2>Output Files (#(files.count))</h2>
  <ul>
    #for(file in files):
    <li>#(file)</li>
    #endfor
  </ul>
  #endif

  <h2>Build Log</h2>
  <pre>#(log)</pre>

</main>

<footer style="text-align:center;padding:2rem;font-size:0.8rem;color:#999;">
  SVPB TNG v#(appVersion)
</footer>

</body>
</html>
