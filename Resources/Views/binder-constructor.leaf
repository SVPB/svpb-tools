#extend("layouts/public"):

#export("title"):Binder Constructor — SVPB TNG#endexport

#export("styles"):
#extend("partials/tune-selector-styles")
<style>
  textarea   { width: 100%; min-height: 200px; font-family: monospace; font-size: 0.82rem; padding: 0.6rem; border: 1px solid #ccc; border-radius: 4px; resize: vertical; }
  .btn-danger  { background: #fee; color: #c00; border: 1px solid #f99; }
  #status-msg { font-size: 0.85rem; color: #666; margin-top: 0.5rem; min-height: 1.2em; }
</style>
#endexport

#export("content"):
<main>

  <!-- Left column: tune catalogue -->
  <div>
    #extend("partials/tune-catalogue"):
      #export("binder-name-label"):Binder name#endexport
      #export("binder-name-placeholder"):e.g. 2026 Band Binder#endexport
    #endextend
  </div>

  <!-- Right column: selected entries -->
  <div>
    <div class="card">
      #extend("partials/binder-entries"):
        #export("entries-heading"):Selected Entries#endexport
      #endextend
    </div>

    <div class="card" style="margin-top:1rem;">
      <h2>Generated YAML</h2>
      <textarea id="yaml-output" readonly placeholder="Click &quot;Generate YAML&quot; to see the binder definition."></textarea>
      <div style="display:flex;gap:0.5rem;margin-top:0.5rem;">
        <button class="btn btn-primary" onclick="generateYAML()">Generate YAML</button>
        <button class="btn" onclick="TuneSelector.clear()">Clear</button>
      </div>
      <div id="status-msg"></div>
    </div>
  </div>

</main>
#endexport

#export("scripts"):
<script src="/js/tune-selector.js"></script>
<script>
'use strict';

TuneSelector.init({
  setStatus,
  onClear: () => { document.getElementById('yaml-output').value = ''; },
});

// ── Output ─────────────────────────────────────────────────────────────────
function generateYAML() {
  const branch = TuneSelector.branch();
  const name = TuneSelector.binderName('Untitled Binder');
  const entries = TuneSelector.entries();
  if (!branch) { setStatus('Please select a year first.'); return; }
  if (entries.length === 0) { setStatus('No tunes selected.'); return; }

  const lines = [
    `name: "${name}"`,
    `branch: "${branch}"`,
    `entries:`,
  ];
  entries.forEach(entry => {
    lines.push(`  - tune_slug: "${entry.tuneSlug}"`);
    lines.push(`    parts:`);
    entry.parts.forEach(p => lines.push(`      - "${p}"`));
  });

  document.getElementById('yaml-output').value = lines.join('\n');
  setStatus('YAML generated. Copy and commit it to the svpb-music repository.');
}

// The component reports errors with a severity; this page has only one status
// style, so the argument is accepted and ignored.
function setStatus(msg, _severity) {
  document.getElementById('status-msg').textContent = msg;
}
</script>
#endexport

#endextend
