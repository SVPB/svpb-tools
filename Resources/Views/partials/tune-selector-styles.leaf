<style>
  /* Styles shared by the binder constructor and the personal binder builder.
     Anything that belongs to only one of them stays in that page's own
     styles export. (Leaf parses a literal hash-tag in here as a tag, so this
     comment spells the name out instead.) */
  main   { max-width: 1100px; margin: 2rem auto; padding: 0 1rem; display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  @media (max-width: 700px) { main { grid-template-columns: 1fr; } }
  h2     { font-size: 1.05rem; margin: 0 0 0.75rem; }
  .entries-head { display: flex; justify-content: space-between; align-items: baseline; gap: 0.5rem; margin: 0 0 0.75rem; }
  .entries-head h2 { margin: 0; }
  .btn-link { background: none; border: none; padding: 0; color: #3730a3; font-size: 0.8rem; cursor: pointer; text-decoration: underline; }
  .card  { background: #fff; border-radius: 8px; padding: 1.25rem; box-shadow: 0 1px 3px rgba(0,0,0,.1); }
  .full-width { grid-column: 1 / -1; }
  label  { display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.25rem; }
  select, input[type=text] {
    width: 100%; padding: 0.45rem 0.6rem; border: 1px solid #ccc; border-radius: 4px;
    font-size: 0.9rem; margin-bottom: 0.75rem;
  }
  .tune-list { list-style: none; margin: 0; padding: 0; max-height: 320px; overflow-y: auto; border: 1px solid #e0e0e0; border-radius: 4px; }
  .tune-list li { padding: 0.5rem 0.75rem; border-bottom: 1px solid #f0f0f0; display: flex; justify-content: space-between; align-items: center; font-size: 0.88rem; }
  .tune-list li:last-child { border-bottom: none; }
  .tune-list li.added { background: #f0fdf4; }
  .tune-list li button { font-size: 0.75rem; padding: 2px 8px; border-radius: 3px; border: 1px solid #ccc; cursor: pointer; background: #fff; }
  .tune-list li button:hover { background: #eee; }
  .tune-file { font-family: ui-monospace, Menlo, monospace; font-size: 0.72rem; color: #777; overflow-wrap: anywhere; }
  .binder-entries { list-style: none; margin: 0; padding: 0; }
  .binder-entries li, .binder-entries .section-header { padding: 0.4rem 0.75rem; display: flex; justify-content: space-between; align-items: center; font-size: 0.88rem; background: #f9f9f9; border-radius: 4px; margin-bottom: 4px; }
  .binder-entries li button, .binder-entries .section-header button { font-size: 0.75rem; padding: 2px 8px; border: 1px solid #f99; border-radius: 3px; cursor: pointer; background: #fff; color: #c00; }
  .binder-entries li button:hover, .binder-entries .section-header button:hover { background: #fee; }
  .move-btn { background: none!important; border: none!important; color: #888!important; cursor: pointer; font-size: 1rem; padding: 0 4px!important; }
  /* A section groups its header with its own list, so folding hides one element. */
  .binder-entries li.section-group { display: block; padding: 0; margin-bottom: 0; background: none; border-radius: 0; }
  .section-tunes { list-style: none; margin: 0; padding: 0; }
  .binder-entries .section-header { background: #eef0f6; border-left: 3px solid transparent; margin-top: 0.6rem; gap: 4px; cursor: pointer; }
  .binder-entries li.section-group:first-child .section-header { margin-top: 0; }
  .binder-entries .section-header.active { border-left-color: #3730a3; background: #e0e7ff; }
  .binder-entries .section-header textarea.section-title { flex: 1; margin: 0; font-weight: 600; min-width: 0; resize: vertical; font-family: inherit; font-size: inherit; line-height: 1.3; overflow: hidden; }
  .binder-entries .section-header.title-page { background: #f6f1e8; }
  .binder-entries .section-header.title-page.active { background: #f0e6d2; border-left-color: #8a6d3b; }
  .binder-entries .section-header.contents { background: #e8f1f6; }
  .binder-entries .section-header.contents.active { background: #d6e8f2; border-left-color: #2b6d8a; }
  .binder-entries .section-header.contents .title-page-marker { color: #2b6d8a; }
  .title-page-marker { color: #8a6d3b; font-size: 0.9rem; line-height: 1; padding: 0 6px; cursor: default; }
  .fold-btn { background: none!important; border: none!important; color: #555!important; cursor: pointer; font-size: 0.9rem!important; line-height: 1; padding: 0 4px!important; }
  .section-count { color: #555; font-size: 0.78rem; white-space: nowrap; margin: 0 4px; }
  .binder-entries select.section-move { width: auto; max-width: 9rem; margin: 0 4px; padding: 1px 2px; font-size: 0.75rem; }
  .btn { padding: 0.5rem 1.2rem; border-radius: 4px; border: none; cursor: pointer; font-size: 0.9rem; font-weight: 600; }
  .btn-primary { background: #1a1a2e; color: #fff; }
  .btn-primary:hover { background: #2a2a4e; }
  .add-controls { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .btn-add-section { margin-top: 0.5rem; background: #fff; color: #3730a3; border: 1px dashed #a5b4fc; font-size: 0.85rem; }
  .btn-add-section:hover { background: #eef2ff; }
</style>
