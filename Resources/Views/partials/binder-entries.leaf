<!-- The ordered list of selected tunes. The page supplies the heading and
     wraps this in its own card alongside whatever it builds from the
     selection. -->
<div class="entries-head">
  <h2>#import("entries-heading")</h2>
  <!-- Shown only once there is more than one section to fold. -->
  <button type="button" class="btn-link" id="fold-all-sections" hidden>Fold all</button>
</div>
<p id="empty-msg" style="color:#888; font-size:0.88rem; margin:0 0 0.5rem;">No tunes selected yet.</p>
<ul class="binder-entries" id="binder-entries"></ul>
<!-- Binder-wide: consecutive short tunes may share a sheet instead of each taking
     one of its own. Off by default, because a tune starting half way down a page
     cannot be pulled out and handed to one piper. -->
<label class="pack-option" title="Two short tunes in a row share a sheet. A tune that must start fresh says so with its own control.">
  <input type="checkbox" id="binder-pack">
  Pack short tunes onto shared pages
</label>
<!-- Shown only on pages that turn sections on. A title page is a section with
     no tunes under it, so those two controls add the same thing and differ in
     what they leave the catalogue aimed at; a table of contents is a third kind
     of page, which lists the whole binder wherever it sits. -->
<div class="add-controls">
  <button type="button" class="btn btn-add-section" id="add-section" hidden>+ Add section</button>
  <button type="button" class="btn btn-add-section" id="add-title-page" hidden
          title="A page of text on its own — a cover, or a heading with no tunes under it">+ Add title page</button>
  <button type="button" class="btn btn-add-section" id="add-toc" hidden
          title="Every section and tune in the binder, with the page it starts on">+ Add table of contents</button>
</div>
