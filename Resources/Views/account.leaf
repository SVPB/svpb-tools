#extend("layouts/public"):

#export("title"):Your account — SVPB TNG#endexport

#export("styles"):
<style>
  main   { max-width: 860px; margin: 2rem auto; padding: 0 1rem; }
  h2     { font-size: 1.1rem; margin: 0 0 0.75rem; }
  .card  { background: #fff; border-radius: 8px; padding: 1.25rem; box-shadow: 0 1px 3px rgba(0,0,0,.1); margin-bottom: 1.5rem; }
  .card p { margin: 0.3rem 0; font-size: 0.9rem; color: #444; line-height: 1.5; }
  .muted { color: #666; font-size: 0.85rem; }
  table  { width: 100%; border-collapse: collapse; background: #fff; border-radius: 8px; overflow: hidden; box-shadow: 0 1px 3px rgba(0,0,0,.1); margin-bottom: 1rem; }
  th, td { padding: 0.65rem 1rem; text-align: left; font-size: 0.9rem; vertical-align: middle; }
  th     { background: #eee; font-weight: 600; }
  tr:not(:last-child) td { border-bottom: 1px solid #f0f0f0; }
  td.when { font-size: 0.82rem; color: #555; white-space: nowrap; }
  .badge { display: inline-block; padding: 2px 9px; border-radius: 10px; font-size: 0.75rem; font-weight: 600; background: #dcfce7; color: #166534; margin-left: 0.4rem; }
  .btn { padding: 4px 12px; border-radius: 4px; border: 1px solid #ccc; cursor: pointer; font-size: 0.82rem; background: #fff; }
  .btn:hover { background: #f5f5f5; }
  .btn-danger { color: #c00; border-color: #f99; }
  .btn-danger:hover { background: #fee; }
  .actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  form { display: inline; margin: 0; }
  @media (max-width: 600px) {
    th:nth-child(2), td:nth-child(2) { display: none; }
    th, td { padding: 0.55rem 0.6rem; }
  }
</style>
#endexport

#export("content"):
<main>

  <div class="card">
    <h2>#(currentUser)</h2>
    <p class="muted">Slack ID #(slackUserId) · #(role)</p>
  </div>

  <h2>Where you're signed in</h2>
  <p class="muted">Each browser you have opened a Slack login link in stays signed in until it goes unused for a while, or until you end it here.</p>
  <table>
    <thead>
      <tr>
        <th>Browser</th>
        <th>Signed in</th>
        <th>Last used</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      #for(session in sessions):
      <tr>
        <td title="#(session.userAgent)">
          #(session.device)#if(session.isCurrent):<span class="badge">This browser</span>#endif
        </td>
        <td class="when"><time datetime="#(session.signedInISO)">#(session.signedInISO)</time></td>
        <td class="when">#if(session.isCurrent):Now#else:<time datetime="#(session.lastSeenISO)">#(session.lastSeenISO)</time>#endif</td>
        <td style="text-align:right;">
          <form method="POST" action="/account/sessions/#(session.id)/end">
            <button class="btn" type="submit">End</button>
          </form>
        </td>
      </tr>
      #endfor
    </tbody>
  </table>

  <div class="actions">
    #if(hasOthers):
    <form method="POST" action="/account/sessions/end-others"
          onsubmit="return confirm('Sign out every other browser? This one stays signed in.');">
      <button class="btn" type="submit">Sign out other browsers</button>
    </form>
    #endif
    <form method="POST" action="/account/sessions/end-all"
          onsubmit="return confirm('Sign out everywhere, this browser included? You will need a new login link from Slack.');">
      <button class="btn btn-danger" type="submit">Sign out everywhere</button>
    </form>
  </div>

</main>
#endexport

#export("scripts"):
<script>
'use strict';
// Show the stamps in the reader's own time zone; the ISO text stays if this fails.
for (const el of document.querySelectorAll('time[datetime]')) {
  const date = new Date(el.getAttribute('datetime'));
  if (!isNaN(date)) {
    el.textContent = date.toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' });
    el.title = el.getAttribute('datetime');
  }
}
</script>
#endexport

#endextend
